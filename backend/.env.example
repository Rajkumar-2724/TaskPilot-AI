# ===== TaskPilot AI — Infrastructure Monitoring Backend configuration =====

# Server
PORT=5000
NODE_ENV=development

# MongoDB (start with: mongod, or use MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/taskpilot_ai

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Frontend origin for CORS / Socket.IO
CLIENT_URL=http://localhost:5173

# (Optional) Grounded AI assistant / Gemini features. Leave unset to use the
# rule-based retrieval assistant instead of LLM re-phrasing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Python ML service (cost/time prediction, model management, CUF analysis)
ML_SERVICE_URL=http://localhost:8000

# (Optional) File uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# (Optional) Email notifications
# IMPORTANT: Render free tier blocks outbound SMTP ports (465/587).
# Use port 2525 with requireTLS: true, or set BREVO_API_KEY for
# the Brevo REST API over HTTPS (port 443).
# The SMTP_PASS starts with xsmtpsib- (SMTP key).
# BREVO_API_KEY starts with xkeysib- (HTTP API key).
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskPilot AI <no-reply@example.com>

TIMEZONE=Asia/Kolkata

# Demo/judge admin account
# demoadmin@gmail.com logs in without OTP (bypass applies ONLY to this email).
# Set DEMO_ADMIN_PASSWORD on the dashboard. The original account
# rkrajubhai726@gmail.com is unchanged.
DEMO_ADMIN_EMAIL=demoadmin@gmail.com
DEMO_ADMIN_PASSWORD=
ORIGINAL_ADMIN_EMAIL=rkrajubhai726@gmail.com